{
    "name": "phasync/swerve-laminas",
    "description": "Run Laminas MVC applications on swerve: streamed responses, WebSockets and Server-Sent Events, no rewrite.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laminas", "laminas-mvc", "zend-framework", "swerve", "phasync", "application server", "long-running", "psr-15", "websocket"],
    "authors": [
        {
            "name": "Frode Børli",
            "email": "frode@ennerd.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-session": "*",
        "laminas/laminas-mvc": "^3.8",
        "phasync/phasync": "dev-main",
        "phasync/swerve": "dev-main as 0.1.0-beta7",
        "phasync/swerve-psr15": "dev-main",
        "psr/http-server-handler": "^1.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0 || ^4.0",
        "friendsofphp/php-cs-fixer": "^3.58"
    },
    "autoload": {
        "psr-4": {
            "Swerve\\Laminas\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "extra": {
        "swerve": {
            "adapter": "laminas",
            "entry": "Swerve\\Laminas\\entry"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "@php vendor/bin/pest --stop-on-defect",
        "php-cs-fixer": "vendor/bin/php-cs-fixer fix --verbose",
        "php-cs-fixer-dry-run": "vendor/bin/php-cs-fixer fix --verbose --diff --dry-run"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [
        {
            "name": "swerve-psr15",
            "type": "vcs",
            "url": "https://github.com/phasync/swerve-psr15"
        }
    ]
}
